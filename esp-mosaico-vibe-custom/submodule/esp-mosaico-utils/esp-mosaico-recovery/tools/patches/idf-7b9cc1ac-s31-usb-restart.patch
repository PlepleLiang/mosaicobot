+    // USB has its own DMA master, independent of GDMA. A CPU-only restart can
+    // leave EP0 receiving SETUP packets into the previous image's SRAM buffer.
+    // Quiesce it after both CPUs/tasks are stopped, before loading another image.
+    const uint32_t usb_clocks = HP_SYS_CLKRST_REG_USB_OTGHS_APB_CLK_EN |
+                                HP_SYS_CLKRST_REG_USB_OTGHS_SYS_CLK_EN;
+    if ((REG_READ(HP_SYS_CLKRST_USB_OTGHS_CTRL0_REG) & usb_clocks) == usb_clocks) {
+        usb_dwc_dev_t *usb = USB_DWC_LL_GET_HW(0);
+        if (usb->gahbcfg_reg.dmaen && !usb->gintsts_reg.curmod) {
+            usb->dctl_reg.sftdiscon = 1;
+            usb_dwc_ll_gahbcfg_dis_global_intr(usb);
+            // Match DWC2 deinit: wait for AHB idle before and after core reset.
+            // esp_restart_noos has already armed the RTC watchdog.
+            while (!usb_dwc_ll_grstctl_is_ahb_idle(usb));
+            usb_dwc_ll_grstctl_core_soft_reset(usb);
+            while (!usb_dwc_ll_grstctl_is_ahb_idle(usb));
+            usb_dwc_ll_gahbcfg_en_slave_mode(usb);
+            usb->dctl_reg.sftdiscon = 1;
+        }
+    }
+
